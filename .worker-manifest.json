  "sugyot[*].display.title",
  "sugyot[*].display.whats",
  "sugyot[*].display.hint",
  "sugyot[*].display.oneLine",
  "sugyot[*].display.shortSummary",
  "sugyot[*].learning.learnerQuestion",
  "sugyot[*].learning.coreTension",
  "sugyot[*].learning.coreMove",
  "sugyot[*].learning.resolution",
  "sugyot[*].learning.ahaMoment",
