{
 "type": "gemara-learning",
 "module": "yoma",
 "targets": [
  "83b"
 ],
 "model": "sonnet",
 "paused": false,
 "lifecycle": "pr",
 "mechanicalTier": false,
 "independentReviewRequired": true,
 "reviewPolicy": "independent",
 "escalationModel": "sonnet",
 "authorizations": [],
 "maxBatch": null,
 "allowedFiles": [
  "modules/<module>/assets/learning/<module>/<daf>.learning.json",
  "modules/<module>/learning_data.js",
  "modules/<module>/coverage.json",
  "VERSION",
  "package.json",
  "package-lock.json",
  "docs/rashi-audit-backlog.md",
  "docs/<module>-perek-review.md",
  ".worker-manifest.json"
 ],
 "allowedJsonPaths": [
  "sugyot[*].display.whats",
  "sugyot[*].display.hint",
  "sugyot[*].display.title",
  "sugyot[*].learning.ahaMoment",
  "sugyot[*].learning.memoryAnchor",
  "sugyot[*].learning.learnerQuestion",
  "sugyot[*].learning.coreTension",
  "sugyot[*].learning.coreMove",
  "sugyot[*].learning.takeaway.text",
  "sugyot[*].learning.learningBlocker"
 ],
 "forbiddenFiles": [
  ".github/workflows/*",
  "scripts/*",
  "modules/yoma/scripts/*.py",
  "githooks/*",
  "modules/yoma/scripts/allowlists/*"
 ],
 "allowlistPolicy": "forbidden",
 "structurePolicy": "requires-authorization",
 "requiredValidators": [
  "validate:offline:yoma"
 ],
 "generationCommands": [
  "cd modules/yoma && python3 scripts/build_learning_data.py",
  "cd modules/yoma && python3 scripts/build_literal_layer.py --apply"
 ],
 "buildTestCommands": [
  "npm run build",
  "npm run check:deploy-html",
  "npm test",
  "npm run test:browser"
 ],
 "escalationTriggers": [
  "any change to source he/en fields would be needed",
  "sugya boundary or id changes would be needed",
  "schema fields not in shared/schema_map.js would be needed"
 ],
 "allowlistDrain": null,
 "scaffoldDebt": null,
 "repetitionDrain": null,
 "auditRecordIds": [],
 "migrationKinds": []
}
