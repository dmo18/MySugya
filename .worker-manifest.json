{
 "type": "enrichment-schema-migration",
 "module": "yoma",
 "targets": [
  "87a"
 ],
 "model": "sonnet",
 "paused": false,
 "lifecycle": "pr",
 "mechanicalTier": true,
 "independentReviewRequired": false,
 "reviewPolicy": "none",
 "escalationModel": "sonnet",
 "authorizations": [
  "authorizeMigration",
  "allowStructure"
 ],
 "maxBatch": 1,
 "allowedFiles": [
  "modules/<module>/assets/learning/<module>/<daf>.learning.json",
  "modules/<module>/learning_data.js",
  "modules/<module>/coverage.json",
  "VERSION",
  "package.json",
  "package-lock.json",
  "docs/rashi-audit-backlog.md",
  "docs/<module>-perek-review.md",
  ".worker-manifest.json"
 ],
 "allowedJsonPaths": [
  "sugyot[*].requiresUnderstanding[*]",
  "sugyot[*].prerequisiteKnowledge",
  "sugyot[*].prerequisiteKnowledge[*]",
  "sugyot[*].visualizableElements[*]",
  "sugyot[*].difficulty"
 ],
 "forbiddenFiles": [
  "modules/<module>/assets/talmuddev/*",
  "modules/<module>/assets/daftexts/*",
  "modules/<module>/source_store.js"
 ],
 "allowlistPolicy": "must-not-grow",
 "structurePolicy": "requires-authorization",
 "requiredValidators": [
  "validate:offline:yoma",
  "validate:enrichment-contracts:yoma"
 ],
 "generationCommands": [
  "npm run build:yoma"
 ],
 "buildTestCommands": [
  "npm run build",
  "npm run check:deploy-html",
  "npm test",
  "npm run test:browser"
 ],
 "escalationTriggers": [
  "target enrichment-contract debt does not strictly decrease",
  "a value would be invented rather than moved or normalized",
  "before/after transformation report is incomplete",
  "a transformation not listed in the manifest is required"
 ],
 "allowlistDrain": null,
 "scaffoldDebt": null,
 "repetitionDrain": null,
 "auditRecordIds": [],
 "migrationKinds": [
  "requires-understanding",
  "visualizable-elements"
 ]
}
