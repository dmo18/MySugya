{
 "type": "docs-tooling",
 "module": "yoma",
 "targets": [],
 "model": "fable",
 "paused": false,
 "fableReviewRequired": false,
 "reviewPolicy": "none",
 "escalationModel": "fable",
 "authorizations": [],
 "maxBatch": null,
 "allowedFiles": [
  "docs/*",
  "scripts/*",
  "modules/yoma/scripts/*.py",
  "modules/yoma/scripts/allowlists/*",
  ".github/workflows/*",
  "githooks/*",
  "package.json",
  "package-lock.json",
  "VERSION",
  "README.md",
  "CLAUDE.md",
  "SOURCES.md",
  "tests/*",
  ".worker-manifest.json",
  ".worker-queue.json"
 ],
 "allowedJsonPaths": [],
 "forbiddenFiles": [
  "modules/yoma/assets/learning/*",
  "modules/yoma/assets/talmuddev/*",
  "modules/yoma/assets/daftexts/*",
  "modules/yoma/source_store.js"
 ],
 "allowlistPolicy": "restructure-with-env",
 "structurePolicy": "not-applicable",
 "requiredValidators": [
  "validate:offline:yoma"
 ],
 "generationCommands": [],
 "buildTestCommands": [
  "npm run build",
  "npm run check:deploy-html",
  "npm test",
  "npm run test:browser"
 ],
 "escalationTriggers": [
  "any existing gate would be weakened",
  "workflow permission changes would be needed"
 ],
 "allowlistDrain": null
}
