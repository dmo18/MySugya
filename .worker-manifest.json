{
 "type": "rashi-translation-review",
 "module": "yoma",
 "targets": [
  "81a"
 ],
 "model": "sonnet",
 "paused": false,
 "lifecycle": "pr",
 "mechanicalTier": false,
 "independentReviewRequired": false,
 "reviewPolicy": "none",
 "escalationModel": "sonnet",
 "authorizations": [],
 "maxBatch": null,
 "allowedFiles": [
  "modules/<module>/assets/learning/<module>/<daf>.learning.json",
  "modules/<module>/learning_data.js",
  "modules/<module>/coverage.json",
  "VERSION",
  "package.json",
  "package-lock.json",
  "docs/rashi-audit-backlog.md",
  "docs/reports/data/rashi-translation-quality-inventory.json",
  "docs/reports/data/rashi-step6-batch-*-review-records.json",
  "docs/reports/rashi-pilot-*.md",
  "docs/reports/rashi-step6-batch-*-report.md",
  "docs/reports/rashi-full-corpus-review-strategy.md",
  "modules/<module>/scripts/validate_rashi_review_records.py",
  "modules/<module>/scripts/test_validate_rashi_review_records.py",
  "modules/<module>/scripts/check_rashi_pr_scope.py",
  "scripts/worker_task_types.json",
  ".worker-manifest.json"
 ],
 "allowedJsonPaths": [
  "rashiTranslations[*].en"
 ],
 "forbiddenFiles": [
  ".github/workflows/*",
  "scripts/*",
  "modules/yoma/scripts/*.py",
  "githooks/*"
 ],
 "allowlistPolicy": "not-applicable",
 "structurePolicy": "forbidden",
 "requiredValidators": [
  "validate:offline:yoma",
  "check:rashi-pr-scope:yoma"
 ],
 "generationCommands": [
  "cd modules/yoma && python3 scripts/build_learning_data.py",
  "cd modules/yoma && python3 scripts/build_literal_layer.py --apply"
 ],
 "buildTestCommands": [
  "npm run build",
  "npm run check:deploy-html",
  "npm test",
  "npm run test:browser"
 ],
 "escalationTriggers": [
  "Hebrew source appears defective",
  "an entry boundary or linkedGemaraLineIds association appears wrong",
  "the correct translation cannot be resolved responsibly (record BLOCKED instead of guessing)",
  "a proposed change fails its own second semantic pass",
  "any gate failure not fixable by correcting the entry's own English"
 ],
 "allowlistDrain": null,
 "scaffoldDebt": null,
 "repetitionDrain": null
}
