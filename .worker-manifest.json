{
 "type": "rashi-realignment",
 "module": "yoma",
 "targets": [
  "68b"
 ],
 "model": "sonnet",
 "paused": false,
 "fableReviewRequired": true,
 "authorizations": [],
 "maxBatch": 1,
 "allowedFiles": [
  "modules/yoma/assets/learning/yoma/<daf>.learning.json",
  "modules/yoma/learning_data.js",
  "modules/yoma/coverage.json",
  "VERSION",
  "package.json",
  "package-lock.json",
  "docs/rashi-audit-backlog.md",
  "modules/yoma/scripts/allowlists/*",
  ".worker-manifest.json"
 ],
 "allowedJsonPaths": [
  "rashiTranslations[*].en",
  "rashiTranslations[*].linkedGemaraLineIds"
 ],
 "forbiddenFiles": [
  ".github/workflows/*",
  "scripts/*",
  "modules/yoma/scripts/*.py",
  "githooks/*"
 ],
 "allowlistPolicy": "remove-only",
 "structurePolicy": "forbidden",
 "requiredValidators": [
  "validate:offline:yoma",
  "check:rashi-pr-scope:yoma"
 ],
 "generationCommands": [
  "cd modules/yoma && python3 scripts/build_learning_data.py",
  "cd modules/yoma && python3 scripts/build_literal_layer.py --apply"
 ],
 "buildTestCommands": [
  "npm run build",
  "npm run check:deploy-html",
  "npm test",
  "npm run test:browser"
 ],
 "escalationTriggers": [
  "uncertain Hebrew meaning or placement",
  "post-edit drift profile still SHIFTED or FABRICATION-SUSPECT (worker:verify enforces this)",
  "count mismatch not already baselined",
  "any gate failure not fixable by correcting your own content"
 ]
}
