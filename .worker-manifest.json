{
 "type": "rashi-repair",
 "module": "yoma",
 "targets": [
  "42b"
 ],
 "model": "sonnet",
 "paused": false,
 "fableReviewRequired": false,
 "reviewPolicy": "none",
 "escalationModel": "sonnet",
 "authorizations": [],
 "maxBatch": null,
 "allowedFiles": [
  "modules/yoma/assets/learning/yoma/<daf>.learning.json",
  "modules/yoma/learning_data.js",
  "modules/yoma/coverage.json",
  "VERSION",
  "package.json",
  "package-lock.json",
  "docs/rashi-audit-backlog.md",
  "modules/yoma/scripts/allowlists/*",
  "modules/yoma/scripts/baselines/*",
  ".worker-manifest.json"
 ],
 "allowedJsonPaths": [
  "rashiTranslations[*].en",
  "rashiTranslations[*].linkedGemaraLineIds"
 ],
 "forbiddenFiles": [
  ".github/workflows/*",
  "scripts/*",
  "modules/yoma/scripts/*.py",
  "githooks/*"
 ],
 "allowlistPolicy": "remove-only",
 "structurePolicy": "forbidden",
 "requiredValidators": [
  "validate:offline:yoma",
  "check:rashi-pr-scope:yoma"
 ],
 "generationCommands": [
  "cd modules/yoma && python3 scripts/build_learning_data.py",
  "cd modules/yoma && python3 scripts/build_literal_layer.py --apply"
 ],
 "buildTestCommands": [
  "npm run build",
  "npm run check:deploy-html",
  "npm test",
  "npm run test:browser"
 ],
 "escalationTriggers": [
  "uncertain Hebrew meaning or placement",
  "a Rashi comment whose correct target segment cannot be identified from the packet's segment text (never guess, never link positionally)",
  "target daf classified SHIFTED or FABRICATION-SUSPECT by the drift profile (preflight blocks this; never work around it)",
  "count mismatch not already baselined",
  "new semantic audit shift candidate beyond offset +-1",
  "any gate failure not fixable by correcting your own content"
 ],
 "allowlistDrain": null,
 "scaffoldDebt": null,
 "repetitionDrain": null
}
